{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "layer12-fixed-family-publication.v1.schema.json",
  "title": "DSPx Layer-12 closed fixed-family spec and owner-local publication",
  "description": "One-token owner-local evidence contract. It grants no AK legality, affected-use publication, policy selection, apply, promotion, activation, dogfood, or rollout authority.",
  "oneOf": [
    {
      "$ref": "#/$defs/spec"
    },
    {
      "$ref": "#/$defs/publication"
    },
    {
      "$ref": "#/$defs/familyImport"
    },
    {
      "$ref": "#/$defs/withdrawal"
    },
    {
      "$ref": "#/$defs/reconstruction"
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "time": {
      "type": "string",
      "format": "date-time"
    },
    "wireEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_owner",
        "wire_identity",
        "wire_digest",
        "declaration_is_trust_root"
      ],
      "properties": {
        "source_owner": {
          "const": "softwareco/owned/agent-kernel"
        },
        "wire_identity": {
          "type": "string",
          "minLength": 1
        },
        "wire_digest": {
          "$ref": "#/$defs/digest"
        },
        "declaration_is_trust_root": {
          "const": false
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner_local_artifact_publication",
        "affected_use_publication",
        "ak_legality",
        "policy_selection",
        "apply",
        "promotion",
        "activation",
        "dogfood",
        "rollout"
      ],
      "properties": {
        "owner_local_artifact_publication": {
          "const": true
        },
        "affected_use_publication": {
          "const": false
        },
        "ak_legality": {
          "const": false
        },
        "policy_selection": {
          "const": false
        },
        "apply": {
          "const": false
        },
        "promotion": {
          "const": false
        },
        "activation": {
          "const": false
        },
        "dogfood": {
          "const": false
        },
        "rollout": {
          "const": false
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "owner",
        "family_id",
        "protocol_version",
        "transition_tokens",
        "scope_digest",
        "ak_wire_evidence",
        "publication_contract",
        "reconstruction_contract",
        "authority_boundary"
      ],
      "properties": {
        "schema_version": {
          "const": "layer12-fixed-family-spec-v1"
        },
        "owner": {
          "const": "softwareco/owned/dspx"
        },
        "family_id": {
          "enum": [
            "dspx.layer12.continue-current-execution-task.v1",
            "dspx.layer12.request-owner-route.v1"
          ]
        },
        "protocol_version": {
          "const": "layer12-v1"
        },
        "transition_tokens": {
          "type": "array",
          "prefixItems": [
            {
              "enum": [
                "continue_current_execution_task",
                "request_owner_route"
              ]
            }
          ],
          "items": false,
          "minItems": 1,
          "maxItems": 1
        },
        "scope_digest": {
          "$ref": "#/$defs/digest"
        },
        "ak_wire_evidence": {
          "$ref": "#/$defs/wireEvidence"
        },
        "publication_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "publication_scope",
            "signed_payload",
            "signature_algorithm",
            "external_trust_required"
          ],
          "properties": {
            "publication_scope": {
              "const": "owner_local_artifact_only"
            },
            "signed_payload": {
              "const": "publication_object_without_signature"
            },
            "signature_algorithm": {
              "const": "Ed25519"
            },
            "external_trust_required": {
              "const": true
            }
          }
        },
        "authority_boundary": {
          "$ref": "#/$defs/authority"
        },
        "reconstruction_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "identity_key",
            "epoch_order",
            "withdrawal_scope",
            "preserve_unrelated_imports"
          ],
          "properties": {
            "mode": {
              "const": "cumulative_owner_local_family_epochs"
            },
            "identity_key": {
              "type": "array",
              "prefixItems": [
                {
                  "const": "owner"
                },
                {
                  "const": "family_id"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "epoch_order": {
              "const": "strictly_monotonic_per_family"
            },
            "withdrawal_scope": {
              "const": "matching_owner_family_epoch_only"
            },
            "preserve_unrelated_imports": {
              "const": true
            }
          }
        },
        "program_evidence": {
          "$ref": "#/$defs/programEvidence"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "family_id": {
                "const": "dspx.layer12.continue-current-execution-task.v1"
              }
            },
            "required": [
              "family_id"
            ]
          },
          "then": {
            "properties": {
              "transition_tokens": {
                "const": [
                  "continue_current_execution_task"
                ]
              }
            },
            "not": {
              "required": [
                "program_evidence"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "family_id": {
                "const": "dspx.layer12.request-owner-route.v1"
              }
            },
            "required": [
              "family_id"
            ]
          },
          "then": {
            "required": [
              "program_evidence"
            ],
            "properties": {
              "transition_tokens": {
                "const": [
                  "request_owner_route"
                ]
              }
            }
          }
        }
      ]
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "publication_id",
        "published_at",
        "publication_scope",
        "publication_lifecycle",
        "identity",
        "ak_wire_evidence",
        "signer_evidence",
        "authority_boundary",
        "signature"
      ],
      "properties": {
        "schema_version": {
          "const": "layer12-fixed-family-publication-v1"
        },
        "publication_id": {
          "type": "string",
          "minLength": 1
        },
        "published_at": {
          "$ref": "#/$defs/time"
        },
        "publication_scope": {
          "const": "owner_local_artifact_only"
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "owner",
            "family_id",
            "protocol_version",
            "transition_token",
            "spec_schema_version",
            "spec_digest",
            "scope_digest"
          ],
          "properties": {
            "owner": {
              "const": "softwareco/owned/dspx"
            },
            "family_id": {
              "enum": [
                "dspx.layer12.continue-current-execution-task.v1",
                "dspx.layer12.request-owner-route.v1"
              ]
            },
            "protocol_version": {
              "const": "layer12-v1"
            },
            "transition_token": {
              "enum": [
                "continue_current_execution_task",
                "request_owner_route"
              ]
            },
            "spec_schema_version": {
              "const": "layer12-fixed-family-spec-v1"
            },
            "spec_digest": {
              "$ref": "#/$defs/digest"
            },
            "scope_digest": {
              "$ref": "#/$defs/digest"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "family_id": {
                    "const": "dspx.layer12.continue-current-execution-task.v1"
                  }
                },
                "required": [
                  "family_id"
                ]
              },
              "then": {
                "properties": {
                  "transition_token": {
                    "const": "continue_current_execution_task"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "family_id": {
                    "const": "dspx.layer12.request-owner-route.v1"
                  }
                },
                "required": [
                  "family_id"
                ]
              },
              "then": {
                "properties": {
                  "transition_token": {
                    "const": "request_owner_route"
                  }
                }
              }
            }
          ]
        },
        "ak_wire_evidence": {
          "$ref": "#/$defs/wireEvidence"
        },
        "signer_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "key_id",
            "public_key_b64",
            "key_status",
            "valid_from",
            "valid_until",
            "declaration_is_trust_root"
          ],
          "properties": {
            "algorithm": {
              "const": "Ed25519"
            },
            "key_id": {
              "type": "string",
              "minLength": 1
            },
            "public_key_b64": {
              "type": "string",
              "contentEncoding": "base64"
            },
            "key_status": {
              "const": "active"
            },
            "valid_from": {
              "$ref": "#/$defs/time"
            },
            "valid_until": {
              "$ref": "#/$defs/time"
            },
            "declaration_is_trust_root": {
              "const": false
            }
          }
        },
        "authority_boundary": {
          "$ref": "#/$defs/authority"
        },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "algorithm",
            "key_id",
            "signed_payload_digest",
            "signature_b64"
          ],
          "properties": {
            "algorithm": {
              "const": "Ed25519"
            },
            "key_id": {
              "type": "string",
              "minLength": 1
            },
            "signed_payload_digest": {
              "$ref": "#/$defs/digest"
            },
            "signature_b64": {
              "type": "string",
              "contentEncoding": "base64"
            }
          }
        },
        "publication_lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "epoch",
            "state_at_signing",
            "withdrawal_ref_at_signing"
          ],
          "properties": {
            "epoch": {
              "type": "integer",
              "minimum": 1
            },
            "state_at_signing": {
              "const": "published"
            },
            "withdrawal_ref_at_signing": {
              "type": "null"
            }
          }
        }
      }
    },
    "familyImport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "owner",
        "family_id",
        "publication_id",
        "epoch",
        "spec_digest",
        "transition_token",
        "publication_scope",
        "authority_granted"
      ],
      "properties": {
        "schema_version": {
          "const": "layer12-fixed-family-import-v1"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "family_id": {
          "type": "string",
          "minLength": 1
        },
        "publication_id": {
          "type": "string",
          "minLength": 1
        },
        "epoch": {
          "type": "integer",
          "minimum": 1
        },
        "spec_digest": {
          "$ref": "#/$defs/digest"
        },
        "transition_token": {
          "type": "string",
          "minLength": 1
        },
        "publication_scope": {
          "const": "owner_local_artifact_only"
        },
        "authority_granted": {
          "const": false
        }
      }
    },
    "withdrawal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "owner",
        "family_id",
        "publication_id",
        "epoch",
        "withdrawal_ref",
        "owner_local_only",
        "authority_granted"
      ],
      "properties": {
        "schema_version": {
          "const": "layer12-fixed-family-withdrawal-v1"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "family_id": {
          "type": "string",
          "minLength": 1
        },
        "publication_id": {
          "type": "string",
          "minLength": 1
        },
        "epoch": {
          "type": "integer",
          "minimum": 1
        },
        "withdrawal_ref": {
          "type": "string",
          "minLength": 1
        },
        "owner_local_only": {
          "const": true
        },
        "authority_granted": {
          "const": false
        }
      }
    },
    "reconstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "mode",
        "imports",
        "family_epoch_high_watermarks",
        "withdrawal_applied",
        "withdrawn_identity",
        "preserve_unrelated_imports",
        "authority_granted"
      ],
      "properties": {
        "schema_version": {
          "const": "layer12-fixed-family-reconstruction-v1"
        },
        "mode": {
          "const": "cumulative_owner_local_family_epochs"
        },
        "imports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/familyImport"
          }
        },
        "withdrawal_applied": {
          "type": "boolean"
        },
        "withdrawn_identity": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "owner",
                "family_id",
                "epoch",
                "publication_id",
                "withdrawal_ref"
              ],
              "properties": {
                "owner": {
                  "type": "string",
                  "minLength": 1
                },
                "family_id": {
                  "type": "string",
                  "minLength": 1
                },
                "epoch": {
                  "type": "integer",
                  "minimum": 1
                },
                "publication_id": {
                  "type": "string",
                  "minLength": 1
                },
                "withdrawal_ref": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "preserve_unrelated_imports": {
          "const": true
        },
        "authority_granted": {
          "const": false
        },
        "family_epoch_high_watermarks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/epochHighWatermark"
          }
        }
      }
    },
    "epochHighWatermark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "owner",
        "family_id",
        "epoch",
        "transition_token",
        "spec_digest",
        "used_publication_ids"
      ],
      "properties": {
        "schema_version": {
          "const": "layer12-fixed-family-epoch-high-watermark-v1"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "family_id": {
          "type": "string",
          "minLength": 1
        },
        "epoch": {
          "type": "integer",
          "minimum": 1
        },
        "transition_token": {
          "type": "string",
          "minLength": 1
        },
        "spec_digest": {
          "$ref": "#/$defs/digest"
        },
        "used_publication_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "hashBound": {
      "type": "object",
      "required": [
        "digest"
      ],
      "properties": {
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "programEvidence": {
      "description": "Exact closed DSPx B1 ProgramIntent, six-signature graph, AK verification sink, and blocked Controls evidence.",
      "const": {
        "program_intent": {
          "schema_version": "program-intent-v2",
          "name": "DirectionController",
          "program_id": "dspx.generated.direction_controller.v1",
          "objective": "Produce advisory Layer-12 transition IR for deterministic AK verification.",
          "inputs": [
            "operator_intent",
            "direction_controller_status",
            "legal_controls",
            "blocked_controls"
          ],
          "outputs": [
            "repaired_transition",
            "verifier_expectation"
          ],
          "family_id": "dspx.layer12.request-owner-route.v1",
          "transition_token": "request_owner_route",
          "effects": "none",
          "digest": "sha256:31916ed199adc9b4202e927296f1232f13b67c9be4beb1ee654002cd17bda578"
        },
        "module_graph": {
          "schema_version": "dspx-fixed-module-graph-v1",
          "program_id": "dspx.generated.direction_controller.v1",
          "signatures": [
            {
              "name": "ExtractLayer12PolicyFacts",
              "inputs": [
                "operator_intent",
                "direction_controller_status"
              ],
              "outputs": [
                "policy_facts",
                "non_authorizations"
              ]
            },
            {
              "name": "DeriveLayer12StateVector",
              "inputs": [
                "direction_controller_status"
              ],
              "outputs": [
                "state_vector",
                "missing_facts"
              ]
            },
            {
              "name": "ProposeLayer12Transition",
              "inputs": [
                "operator_intent",
                "state_vector",
                "legal_controls",
                "blocked_controls"
              ],
              "outputs": [
                "transition",
                "rationale"
              ]
            },
            {
              "name": "CritiqueAuthorityDrift",
              "inputs": [
                "proposed_transition",
                "non_authorizations"
              ],
              "outputs": [
                "authority_drift_risk",
                "required_repair"
              ]
            },
            {
              "name": "CritiqueTheaterTraps",
              "inputs": [
                "proposed_transition",
                "direction_controller_status"
              ],
              "outputs": [
                "theater_risk",
                "required_repair"
              ]
            },
            {
              "name": "RepairLayer12IR",
              "inputs": [
                "proposed_transition",
                "authority_drift_risk",
                "theater_risk"
              ],
              "outputs": [
                "repaired_transition",
                "verifier_expectation"
              ]
            }
          ],
          "execution_order": [
            "ExtractLayer12PolicyFacts",
            "DeriveLayer12StateVector",
            "ProposeLayer12Transition",
            "CritiqueAuthorityDrift",
            "CritiqueTheaterTraps",
            "RepairLayer12IR"
          ],
          "entry_signature": "ExtractLayer12PolicyFacts",
          "terminal_signature": "RepairLayer12IR",
          "closed": true,
          "digest": "sha256:a365b85511a86007c20fcbad649d2776e5ec7589f176de73fbc453e5b689ab99",
          "edges": [
            {
              "source": "DeriveLayer12StateVector.state_vector",
              "target": "ProposeLayer12Transition.state_vector"
            },
            {
              "source": "ExtractLayer12PolicyFacts.non_authorizations",
              "target": "CritiqueAuthorityDrift.non_authorizations"
            },
            {
              "source": "ProposeLayer12Transition.transition",
              "target": "CritiqueAuthorityDrift.proposed_transition"
            },
            {
              "source": "ProposeLayer12Transition.transition",
              "target": "CritiqueTheaterTraps.proposed_transition"
            },
            {
              "source": "ProposeLayer12Transition.transition",
              "target": "RepairLayer12IR.proposed_transition"
            },
            {
              "source": "CritiqueAuthorityDrift.authority_drift_risk",
              "target": "RepairLayer12IR.authority_drift_risk"
            },
            {
              "source": "CritiqueTheaterTraps.theater_risk",
              "target": "RepairLayer12IR.theater_risk"
            }
          ]
        },
        "verification_sink": {
          "source_owner": "softwareco/owned/agent-kernel",
          "surface": "ak.direction_controller.verify",
          "expected_command": "ak direction-controller verify --repo . --proposal <saved-proposal.json> -F json",
          "declaration_is_trust_root": false,
          "apply_performed": false
        },
        "controls_evidence": {
          "schema_version": "ak-direction-controller-controls-evidence-v1",
          "transition_token": "request_owner_route",
          "legal": false,
          "verdict": "blocked",
          "dispatch_ready": false,
          "owner_route_sent": false,
          "missing_preconditions": [
            "owner_route_destination_resolved",
            "owner_route_dispatch_authorized"
          ],
          "declaration_is_ak_authority": false,
          "digest": "sha256:fc8463680fcd5505f8ac6b8ad6346afc85fa92e4fe6bf46ce2f6f8305cbfe182"
        }
      }
    }
  }
}
