{
  "schema_version": "dspx-program-semantic-benchmark-corpus-v2",
  "name": "dspx-generated-program-semantic-corpus",
  "version": 2,
  "thresholds": {
    "min_overall_score": 1.0,
    "min_case_score": 1.0,
    "max_failed_cases": 0
  },
  "cases": [
    {
      "id": "single-module-authority-boundary",
      "category": "authority",
      "intent": {
        "name": "BenchmarkAuthorityProgram",
        "objective": "Explain the authority consequence of a passing benchmark.",
        "inputs": [
          "question"
        ],
        "outputs": [
          "answer"
        ],
        "metric": "exact_match",
        "constraints": [
          "Do not claim that benchmark evidence approves promotion or activation."
        ],
        "quality_criteria": [
          {
            "id": "authority_boundary",
            "output_field": "answer",
            "evaluator": "concept_coverage",
            "required_concept_groups": [
              [
                "evidence only",
                "local evidence"
              ],
              [
                "does not approve",
                "not approve"
              ],
              [
                "promotion",
                "promote"
              ],
              [
                "activate",
                "activation"
              ]
            ],
            "forbidden_concepts": [
              "automatically activates",
              "approval granted"
            ],
            "min_score": 1.0
          }
        ],
        "examples": [
          {
            "inputs": {
              "question": "Does a passing benchmark activate a generated program?"
            },
            "outputs": {
              "answer": "A passing benchmark is local evidence only; it does not approve promotion or activate the program."
            }
          }
        ]
      },
      "response_field": "answer",
      "offline_stub_response": {
        "reasoning": "A benchmark result is empirical evidence and does not cross the governance boundary.",
        "answer": "A passing benchmark is local evidence only; it does not approve promotion or activate the program."
      },
      "required_concept_groups": [
        [
          "evidence only",
          "local evidence"
        ],
        [
          "does not approve",
          "not approve"
        ],
        [
          "promotion",
          "promote"
        ],
        [
          "activate",
          "activation"
        ]
      ],
      "forbidden_concepts": [
        "automatically activates",
        "approval granted"
      ],
      "runtime_contract": null
    },
    {
      "id": "pipeline-evidence-calibration",
      "category": "calibration",
      "intent": {
        "name": "BenchmarkCalibrationPipeline",
        "objective": "Analyze observed test evidence and produce a calibrated response.",
        "inputs": [
          "observation"
        ],
        "outputs": [
          "response"
        ],
        "metric": "exact_match",
        "constraints": [
          "Do not invent a cause that is absent from the observation."
        ],
        "quality_criteria": [
          {
            "id": "evidence_calibration",
            "output_field": "response",
            "evaluator": "concept_coverage",
            "required_concept_groups": [
              [
                "one observed failure",
                "one failure",
                "one of ten"
              ],
              [
                "unknown",
                "undetermined"
              ],
              [
                "investigation",
                "investigate"
              ]
            ],
            "forbidden_concepts": [
              "definitely caused",
              "all tests passed"
            ],
            "min_score": 1.0
          }
        ],
        "topology": {
          "kind": "pipeline",
          "execution_status": "declared_not_materialized",
          "modules": [
            {
              "id": "classify_evidence",
              "primitive": "Predict",
              "signature": {
                "name": "ClassifyEvidence",
                "inputs": [
                  "observation"
                ],
                "outputs": [
                  "route"
                ]
              },
              "role": "Classify whether the evidence requires investigation."
            },
            {
              "id": "draft_calibrated_response",
              "primitive": "ChainOfThought",
              "signature": {
                "name": "DraftCalibratedResponse",
                "inputs": [
                  "observation",
                  "route"
                ],
                "outputs": [
                  "response"
                ]
              },
              "role": "Draft a bounded evidence-calibrated response."
            }
          ],
          "edges": [
            {
              "from": "input",
              "to": "classify_evidence"
            },
            {
              "from": "classify_evidence",
              "to": "draft_calibrated_response"
            },
            {
              "from": "draft_calibrated_response",
              "to": "output"
            }
          ]
        },
        "examples": [
          {
            "inputs": {
              "observation": "One of ten tests failed; no cause has been established."
            },
            "outputs": {
              "response": "One observed failure has an unknown cause and needs investigation."
            }
          }
        ]
      },
      "response_field": "response",
      "offline_stub_response": {
        "reasoning": "The observation establishes a failure but supplies no causal evidence.",
        "route": "investigate",
        "response": "One observed failure has an unknown cause and needs investigation."
      },
      "required_concept_groups": [
        [
          "one observed failure",
          "one failure",
          "one of ten"
        ],
        [
          "unknown",
          "undetermined"
        ],
        [
          "investigation",
          "investigate"
        ]
      ],
      "forbidden_concepts": [
        "definitely caused",
        "all tests passed"
      ],
      "runtime_contract": null
    },
    {
      "id": "pdf-transition-review-runtime-replay",
      "category": "review-boundary",
      "intent": {
        "name": "BenchmarkPdfTransitionReview",
        "objective": "Produce bounded review-only PDF transition evidence without canonical mutation.",
        "inputs": [
          "document"
        ],
        "outputs": [
          "section_units_json",
          "distillation_frames_json",
          "evidence_cards_json",
          "merge_create_proposals_json",
          "review_packet_json",
          "artifact_contract_manifest_json"
        ],
        "metric": "exact_match",
        "constraints": [
          "Preserve review-only posture and do not claim canonical mutation, acceptance, promotion, or activation."
        ],
        "quality_criteria": [
          {
            "id": "review_boundary_quality",
            "output_field": "review_packet_json",
            "evaluator": "concept_coverage",
            "required_concept_groups": [
              [
                "review required"
              ],
              [
                "canonical mutation not performed"
              ],
              [
                "evidence"
              ],
              [
                "proposal"
              ]
            ],
            "forbidden_concepts": [
              "domain approved",
              "promotion approved",
              "activation applied"
            ],
            "min_score": 1.0
          }
        ],
        "examples": [
          {
            "inputs": {
              "document": "Bounded source evidence requiring human review."
            },
            "outputs": {
              "section_units_json": "[{\"id\":\"section-1\",\"source\":\"bounded source\"}]",
              "distillation_frames_json": "[{\"section_id\":\"section-1\",\"status\":\"review_required\"}]",
              "evidence_cards_json": "[{\"evidence_id\":\"evidence-1\",\"provenance\":\"bounded source\"}]",
              "merge_create_proposals_json": "[{\"proposal_id\":\"proposal-1\",\"canonical_mutation_allowed\":false,\"review_required\":true}]",
              "review_packet_json": "{\"canonical_mutation_performed\":false,\"summary\":\"Review required; canonical mutation not performed; evidence remains a proposal.\"}",
              "artifact_contract_manifest_json": "{\"canonical_mutation_performed\":false,\"authority\":\"review_only\"}"
            }
          }
        ]
      },
      "response_field": "review_packet_json",
      "offline_stub_response": {
        "reasoning": "The source supports a review-only proposal and no canonical mutation.",
        "section_units_json": "[{\"id\":\"section-1\",\"source\":\"bounded source\"}]",
        "distillation_frames_json": "[{\"section_id\":\"section-1\",\"status\":\"review_required\"}]",
        "evidence_cards_json": "[{\"evidence_id\":\"evidence-1\",\"provenance\":\"bounded source\"}]",
        "merge_create_proposals_json": "[{\"proposal_id\":\"proposal-1\",\"canonical_mutation_allowed\":false,\"review_required\":true}]",
        "review_packet_json": "{\"canonical_mutation_performed\":false,\"summary\":\"Review required; canonical mutation not performed; evidence remains a proposal.\"}",
        "artifact_contract_manifest_json": "{\"canonical_mutation_performed\":false,\"authority\":\"review_only\"}"
      },
      "required_concept_groups": [
        [
          "review required"
        ],
        [
          "canonical mutation not performed"
        ],
        [
          "evidence"
        ],
        [
          "proposal"
        ]
      ],
      "forbidden_concepts": [
        "domain approved",
        "promotion approved",
        "activation applied"
      ],
      "runtime_contract": {
        "contract_mode": "pdf_transition_review",
        "offline_execution_replay_required": true
      }
    }
  ]
}
