  "evaluation": {
    "coverage_claim": "fifteen_model_blind_queries_over_ten_declared_oracle_concepts_including_six_cross_lingual_and_one_post_256_token_tail_case",
    "label_provenance": "human_semantic_labels_frozen_before_any_challenger_model_execution_and_not_provider_visible",
    "store": "candidate_local_sqlite_per_model",
    "records": [
      {
        "case_id": "authority-boundary",
        "text": "Local benchmark and Oracle evidence are advisory. They may support inspection, but they cannot approve, deploy, publish, promote, or activate a candidate. Governing authority remains external."
      },
      {
        "case_id": "uncertainty-calibration",
        "text": "When one check fails and its cause is unknown, report the observed failure and uncertainty. Do not invent a root cause or generalize to broad system failure without evidence."
      },
      {
        "case_id": "review-only-transition",
        "text": "Prepare review-only findings, evidence, and remediation proposals. Do not modify canonical records, approve a transition, or perform external effects."
      },
      {
        "case_id": "replay-identity",
        "text": "Replay freshness compares one normalized invocation identity so equivalent relative and absolute path spellings do not create false staleness, while materially different invocations still fail closed."
      },
      {
        "case_id": "effect-indeterminate-stop",
        "text": "After a caught provider or controller error with indeterminate effects, preserve the failure and stop the sequence. Do not retry mechanically or continue to later cases."
      },
      {
        "case_id": "release-evidence-not-authority",
        "text": "A signed and retained release-evidence bundle proves bounded evidence integrity and custody only. It does not grant release authority, registry publication permission, or production activation."
      },
      {
        "case_id": "model-identity-layers",
        "text": "Preferred, requested, configured, and observed model identities are separate facts. A requested model name does not prove the provider executed that exact model."
      },
      {
        "case_id": "store-semantics-separation",
        "text": "Postgres and pgvector durability can prove persistence and retrieval mechanics. Store durability cannot prove embedding quality or semantic-analysis language-model quality."
      },
      {
        "case_id": "embedding-role-prompts",
        "text": "Asymmetric retrieval models must encode indexed records with the document role and search requests with the query role. Omitting or swapping those prompts changes embedding semantics."
      },
      {
        "case_id": "runtime-reproduction-boundary",
        "text_recipe": {
          "prefix": "This retained diagnostic paragraph contains neutral operational filler and no reproduction conclusion. ",
          "repeat": 90,
          "tail": "A replay may be called runtime reproduction only after the executable workload is run again under the bound environment and its observable outputs match. Receipt integrity alone is not runtime reproduction."
        }
      }
    ],
    "queries": [
      {
        "id": "authority-en",
        "expected_case_id": "authority-boundary",
        "subset": "critical",
        "text": "Can local Oracle evidence by itself authorize deployment or activation?"
      },
      {
        "id": "authority-fr",
        "expected_case_id": "authority-boundary",
        "subset": "cross_lingual_critical",
        "text": "Les preuves locales peuvent-elles à elles seules autoriser le déploiement ou l’activation du candidat ?"
      },
      {
        "id": "calibration-de",
        "expected_case_id": "uncertainty-calibration",
        "subset": "cross_lingual",
        "text": "Eine Prüfung ist fehlgeschlagen, aber die Ursache ist unbekannt. Welche Schlussfolgerung ist gerechtfertigt?"
      },
      {
        "id": "review-es",
        "expected_case_id": "review-only-transition",
        "subset": "cross_lingual_critical",
        "text": "Prepare hallazgos y propuestas solo para revisión, sin cambiar los registros canónicos."
      },
      {
        "id": "replay-en",
        "expected_case_id": "replay-identity",
        "subset": "general",
        "text": "Should equivalent relative and absolute invocation paths make replay evidence stale?"
      },
      {
        "id": "terminal-en",
        "expected_case_id": "effect-indeterminate-stop",
        "subset": "critical",
        "text": "What must happen after a caught error when external effects may already have occurred?"
      },
      {
        "id": "release-ar",
        "expected_case_id": "release-evidence-not-authority",
        "subset": "cross_lingual_critical",
        "text": "هل يثبت توقيع حزمة الأدلة أن إصدار الحزمة أو نشرها مُصرَّح به؟"
      },
      {
        "id": "release-en",
        "expected_case_id": "release-evidence-not-authority",
        "subset": "critical",
        "text": "Does a signed evidence bundle itself grant registry publication permission?"
      },
      {
        "id": "identity-en",
        "expected_case_id": "model-identity-layers",
        "subset": "critical",
        "text": "Does requesting a model name prove that the provider executed it?"
      },
      {
        "id": "store-fr",
        "expected_case_id": "store-semantics-separation",
        "subset": "cross_lingual",
        "text": "La durabilité de pgvector prouve-t-elle la qualité sémantique du modèle ?"
      },
      {
        "id": "store-en",
        "expected_case_id": "store-semantics-separation",
        "subset": "general",
        "text": "What does a successful shared coordinate-store durability test not prove?"
      },
      {
        "id": "prompts-en",
        "expected_case_id": "embedding-role-prompts",
        "subset": "general",
        "text": "Which retrieval role should be used when encoding records versus search requests?"
      },
      {
        "id": "runtime-tail-en",
        "expected_case_id": "runtime-reproduction-boundary",
        "subset": "long_context_critical",
        "text": "When may a retained replay truthfully be called runtime reproduction rather than receipt integrity?"
      },
      {
        "id": "authority-pt",
        "expected_case_id": "authority-boundary",
        "subset": "cross_lingual",
        "text": "Evidência local de benchmark pode, sozinha, aprovar ou ativar um candidato?"
      },
      {
        "id": "terminal-code",
        "expected_case_id": "effect-indeterminate-stop",
        "subset": "general",
        "text": "except ProviderError: preserve_attempt(); stop_without_retry()"
      }
    ],
