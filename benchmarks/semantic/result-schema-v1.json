{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dspx.local/schemas/semantic-benchmark-result-v1.json",
  "title": "DSPx semantic benchmark result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "corpus", "execution", "thresholds", "summary", "cases", "authority"],
  "properties": {
    "schema_version": {"const": "dspx-semantic-benchmark-result-v1"},
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "name", "version", "sha256"],
      "properties": {
        "schema_version": {"const": "dspx-semantic-benchmark-corpus-v1"},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "provider", "network_allowed", "deterministic"],
      "properties": {
        "mode": {"enum": ["offline", "live"]},
        "provider": {"type": ["string", "null"]},
        "network_allowed": {"type": "boolean"},
        "deterministic": {"type": "boolean"}
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_overall_score", "min_case_score", "max_failed_cases"],
      "properties": {
        "min_overall_score": {"type": "number", "minimum": 0, "maximum": 1},
        "min_case_score": {"type": "number", "minimum": 0, "maximum": 1},
        "max_failed_cases": {"type": "integer", "minimum": 0}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cases_total", "cases_passed", "cases_failed", "overall_score", "threshold_pass"],
      "properties": {
        "cases_total": {"type": "integer", "minimum": 1},
        "cases_passed": {"type": "integer", "minimum": 0},
        "cases_failed": {"type": "integer", "minimum": 0},
        "overall_score": {"type": "number", "minimum": 0, "maximum": 1},
        "threshold_pass": {"type": "boolean"}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "status", "score", "required_groups_total", "required_groups_matched", "missing_group_indexes", "forbidden_hits", "response_sha256", "error"],
        "properties": {
          "id": {"type": "string"},
          "category": {"type": "string"},
          "status": {"enum": ["passed", "failed", "error"]},
          "score": {"type": "number", "minimum": 0, "maximum": 1},
          "required_groups_total": {"type": "integer", "minimum": 1},
          "required_groups_matched": {"type": "integer", "minimum": 0},
          "missing_group_indexes": {"type": "array", "items": {"type": "integer", "minimum": 0}},
          "forbidden_hits": {"type": "array", "items": {"type": "string"}},
          "response_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "error": {"type": ["string", "null"]}
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_only", "authoritative_decision", "promotion_approved", "external_authority_mutated", "ak_called"],
      "properties": {
        "evidence_only": {"const": true},
        "authoritative_decision": {"const": false},
        "promotion_approved": {"const": false},
        "external_authority_mutated": {"const": false},
        "ak_called": {"const": false}
      }
    }
  }
}
