# Local dev environment (git-ignored: copy to .env)
#
# Recommended with 1Password CLI:
#   OPENROUTER_API_KEY=op://<Vault>/<Item>/<field>
#
# Or set a real key (less recommended):
#   OPENROUTER_API_KEY=sk-...
#
# Provider selection (optional)
# - Default is DSPX_PROVIDER=codex-exec (Codex CLI).
# - For OpenRouter runs, prefer `just openrouter-*` recipes which set DSPX_PROVIDER=openrouter.
# DSPX_PROVIDER=openrouter

# OpenRouter
OPENROUTER_API_KEY=op://Private/OpenRouter/<field-or-section>
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
OPENROUTER_TIMEOUT=30
OPENROUTER_TEMPERATURE=0
OPENROUTER_MAX_TOKENS=512

# Optional attribution (recommended by OpenRouter docs)
# OPENROUTER_HTTP_REFERER=https://example.com
# OPENROUTER_APP_TITLE=dspx
